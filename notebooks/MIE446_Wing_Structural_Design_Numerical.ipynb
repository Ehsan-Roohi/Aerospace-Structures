    "      Ii=(Bb*Hh**3-(Bb-2*tt)*(Hh-2*tt)**3)/12\n",
    "      sig=M[0]*(Hh/2)/Ii\n",
    "      vv=cumtrapz_from_root(cumtrapz_from_root(M/(E*Ii),y),y)[-1]\n",
    "      Amm=(Bb-tt)*(Hh-tt)\n",
    "      Jj=4*Amm**2/(2*(Bb-tt)/tt+2*(Hh-tt)/tt)\n",
    "      ph=cumtrapz_from_root(T/(Gmat*Jj),y)[-1]\n",
    "      mm=DENSITY_KG_M3*Aa*L\n",
    "      # Geometric clearance is recomputed for height; same chordwise center and box width.\n",
    "      xx=np.linspace(BOX_CENTER_XC*CHORD_M-Bb/2,BOX_CENTER_XC*CHORD_M+Bb/2,61)\n",
    "      up=np.interp(xx,np.sort(xu),yu[np.argsort(xu)]); lo=np.interp(xx,np.sort(xl),yl[np.argsort(xl)])\n",
    "      cy=np.mean(np.r_[up,lo]); clr=np.minimum(up-(cy+Hh/2),(cy-Hh/2)-lo).min()\n",
    "      feasible=(sig<=allow and vv*1000<=DEFLECTION_LIMIT_MM and abs(np.degrees(ph))<=TWIST_LIMIT_DEG and clr*1000>=SKIN_CLEARANCE_MM)\n",
    "      if feasible: results.append((mm,Hmm,Bmm,tmm,sig/1e6,vv*1000,np.degrees(ph),clr*1000))\n",
    "\n",
    "results=sorted(results)\n",
    "if not results:\n",
    "    print(\"No feasible candidate in this search grid. Revisit limits, material, chord, or search range.\")\n",
    "else:\n",
    "    print(\"Five lightest feasible candidates\")\n",
    "    print(\"mass[kg]  H[mm]  B[mm]  t[mm]  stress[MPa]  defl[mm]  twist[deg]  clearance[mm]\")\n",
    "    for r in results[:5]: print(f\"{r[0]:8.4f} {r[1]:6.1f} {r[2]:6.1f} {r[3]:6.1f} {r[4]:11.3f} {r[5]:9.3f} {r[6]:11.4f} {r[7]:13.3f}\")"
