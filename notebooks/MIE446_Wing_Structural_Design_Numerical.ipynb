        "#@title 1B. Check load normalization numerically { display-mode: \"form\" }\n",
        "LOAD_SHAPE = \"Elliptical\" #@param [\"Uniform\", \"Elliptical\"]\n",
        "N_STATIONS = 401 #@param {type:\"integer\"}\n",
